{
  "schemaVersion": 1,
  "id": "voxy_exclusion_zones",
  "version": "${version}",
  "name": "Voxy Exclusion Zones",
  "description": "Client-side circular and square exclusion zones for Voxy terrain fragments.",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.voxyexclude.VoxyExcludeClient"
    ]
  },
  "mixins": [
    "voxy-exclusion-zones.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "voxy": "${voxy_mod_version}"
  }
}
